    {
      "name": "resource-name-wrong-case",
      "url": "https://hub.example.com/Quotes/abc-123",
      "reason": "Resource matching is case-sensitive; 'Quotes' is not 'quotes'."
    },
    {
      "name": "resource-as-substring-only",
      "url": "https://hub.example.com/myquotes/abc-123",
      "reason": "'myquotes' contains 'quotes' but is not a resource segment; the match is anchored on a path separator."
    },
    {
      "name": "empty-url",
      "url": "",
      "reason": "Nothing to derive a URI from."
    }
