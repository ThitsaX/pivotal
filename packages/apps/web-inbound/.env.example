WEB_INBOUND_PORT=3201

# HTTP server keep-alive must outlive upstream connection pools (Hub quoting-service-handler
# and the sidecar Envoy) to avoid read ECONNRESET on reused sockets. headersTimeout must stay
# above keepAliveTimeout. Node defaults (5000/60000) are too low.
WEB_INBOUND_KEEP_ALIVE_TIMEOUT_MS=65000
WEB_INBOUND_HEADERS_TIMEOUT_MS=66000

NATS_URL=nats://localhost:4222

# JetStream stream that backs the FSPIOP response correlation channel.
# Both the publisher (here) and the subscriber (web-outbound) must agree on the name.
PIVOTAL_FSPIOP_RESPONSE_STREAM_NAME=PIVOTAL_FSPIOP_RESPONSE
PIVOTAL_FSPIOP_RESPONSE_MAX_AGE_MS=60000

# Write DB settings
DB_WRITE_HOST=localhost
DB_WRITE_PORT=3306
DB_WRITE_USERNAME=central_ledger
DB_WRITE_PASSWORD=password
DB_WRITE_NAME=pivotal

# Read DB settings
DB_READ_HOST=localhost
DB_READ_PORT=3306
DB_READ_USERNAME=central_ledger
DB_READ_PASSWORD=password
DB_READ_NAME=pivotal

CENTRAL_LEDGER_URL=http://localhost:3001

FSPIOP_PARTIES_URL=http://localhost:3201
FSPIOP_QUOTES_URL=http://localhost:3201
FSPIOP_TRANSFERS_URL=http://localhost:3201
FSPIOP_SWITCH_ID=hub
FSPIOP_USE_JWS=false
FSPIOP_USE_MUTUAL_TLS=false

# Supply deployment-specific PEM values through a secret manager. Do not commit keys.
FSPIOP_JWS_PRIVATE_KEY=
FSPIOP_JWS_PUBLIC_KEY=

FSPIOP_MTLS_CA=
FSPIOP_MTLS_CLIENT_CERT=
FSPIOP_MTLS_CLIENT_KEY=

# ── FSPIOP JWS ───────────────────────────────────────────────────────────────
#
# FSPIOP_USE_JWS is the master switch: outbound signing, and (in web-inbound) the
# inbound guard. When false, nothing below has any effect.
#
# FSPIOP_JWS_VERIFY_MODE is the DEFAULT inbound verification strictness, applied
# only to a source with no row in `participant_key`. A participant's own
# `jws_verify_mode` column always wins -- that override is what lets peers move
# onto signing one at a time instead of by flag day. It is read only by
# web-inbound; no other service verifies FSPIOP signatures.
#
#   off                Signatures ignored entirely.
#   verify-if-present  A present signature must verify; a missing one is accepted
#                      and counted per source. The migration state, and the
#                      rollback. The per-source count of unsigned-but-accepted
#                      requests tells you when `require` is safe for that peer.
#   require            Missing or invalid signature rejected -- 3102 / 3105.
#
# A tri-state rather than a boolean because senders are peer DFSPs and the Hub,
# each enabling signing on its own schedule: `off` leaves a signing peer
# unverified, `require` rejects everyone not yet switched on -- including the Hub,
# which sends its errors unsigned.
#
# Bodyless requests (GET /parties) are accepted unsigned in every mode: a detached
# JWS signs the body, so no implementation signs them.
#
# Outbound signing is per participant (`participant_key.jws_sign_enabled`) and
# needs a key at <VAULT_KV_MOUNT>/<VAULT_JWS_KEY_PATH_PREFIX>/<fspId>.
FSPIOP_USE_JWS=false
FSPIOP_JWS_VERIFY_MODE=off
