# Connection Manager. The token client needs an audience of `connection-manager-api`
# and a `groups` claim; MCM's stock service client ships with neither. See
# trust-manager-docs/implementation/mcm-api-notes.md.
MCM_BASE_URL=http://mcm.localhost/api
MCM_TOKEN_URL=http://keycloak.mcm.localhost/realms/dfsps/protocol/openid-connect/token
MCM_CLIENT_ID=connection-manager-api-service
MCM_CLIENT_SECRET=

# Freshness only — the sync is idempotent, so a missed tick costs nothing.
PEER_JWS_SYNC_INTERVAL_SECONDS=300

# The Hub CA rotates rarely — years, not months — so this poll is a slow backstop.
HUB_CA_SECRET_NAME=hub-ca-bundle
HUB_CA_SYNC_INTERVAL_SECONDS=3600

# Pivotal's own Hub-facing CA, served by Vault PKI without authentication because a
# CA certificate is public. Registered with MCM under every tenant Pivotal fronts.
PIVOTAL_CA_URL=http://vault.vault.svc.cluster.local:8200/v1/pki_hub_client_root/ca/pem
MCM_CA_RECONCILE_INTERVAL_SECONDS=3600

# Fills gaps only: a tenant MCM has no key for. It never replaces a key MCM already
# holds, because peers hold one key each and cannot try both.
JWS_KEY_PUBLISH_INTERVAL_SECONDS=3600

# The server certificate the Hub validates when it calls Pivotal. Issued by the HUB's
# CA through MCM enrollment — the only certificate here that does not come from
# Pivotal's own CA. One for Pivotal, not one per tenant.
PIVOTAL_DFSP_ID=
HUB_SERVER_CERT_COMMON_NAME=web-inbound.pivotal
HUB_SERVER_CERT_SECRET_NAME=hub-server-cert
HUB_SERVER_CERT_CHECK_INTERVAL_SECONDS=86400

REDIS_URL=redis://localhost:7379

DB_WRITE_HOST=localhost
DB_WRITE_PORT=3306
DB_WRITE_USERNAME=central_ledger
DB_WRITE_PASSWORD=password
DB_WRITE_NAME=pivotal
DB_READ_HOST=localhost
DB_READ_PORT=3306
DB_READ_USERNAME=central_ledger
DB_READ_PASSWORD=password
DB_READ_NAME=pivotal

CENTRAL_LEDGER_URL=http://localhost:3001
