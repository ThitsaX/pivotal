# Connection Manager. The stock `connection-manager-api-service` Keycloak client ships with
# no protocol mappers, so its token is refused. Add two in realm `dfsps` — an audience of
# `connection-manager-api`, and `groups` as a full path — and put the client in a group.
# With no groups claim MCM logs `TypeError: roles is not iterable`, which reads like an MCM
# bug rather than a missing mapper.
MCM_BASE_URL=http://mcm.localhost/api
MCM_TOKEN_URL=http://keycloak.mcm.localhost/realms/dfsps/protocol/openid-connect/token
MCM_CLIENT_ID=connection-manager-api-service
MCM_CLIENT_SECRET=

# Freshness only — the sync is idempotent, so a missed tick costs nothing.
PEER_JWS_SYNC_INTERVAL_SECONDS=300

# The Hub CA rotates rarely — years, not months — so this poll is a slow backstop.
HUB_CA_SECRET_NAME=hub-ca-bundle
HUB_CA_SYNC_INTERVAL_SECONDS=3600

# Pivotal's own Hub-facing root certificate, mounted from a Secret the ceremony
# writes. Registered with MCM under every tenant Pivotal fronts. A file rather than a
# Vault path because the root only lives in Vault in a local rehearsal — in a real
# deployment it is in a key service with no export API.
PIVOTAL_CA_PATH=/etc/pivotal/pivotal-ca/ca.pem
MCM_CA_RECONCILE_INTERVAL_SECONDS=3600

# Fills gaps only: a tenant MCM has no key for. It never replaces a key MCM already
# holds, because peers hold one key each and cannot try both.
JWS_KEY_PUBLISH_INTERVAL_SECONDS=3600

# The server certificate the Hub validates when it calls Pivotal. Issued by the HUB's
# CA through MCM enrollment — the only certificate here that does not come from
# Pivotal's own CA. One for Pivotal, not one per tenant.
PIVOTAL_DFSP_ID=
HUB_SERVER_CERT_COMMON_NAME=web-inbound.pivotal
HUB_SERVER_CERT_SECRET_NAME=hub-server-cert
HUB_SERVER_CERT_CHECK_INTERVAL_SECONDS=86400

# Pivotal's Hub-facing CA mount. Its public chain is registered with MCM next to PIVOTAL_CA_PATH's
# root. Defaults to pki_hub_client when VAULT_ADDRESS is set; with no Vault, the root goes alone.
HUB_CLIENT_PKI_MOUNT=pki_hub_client

# The Hub's client certificate for calling web-inbound back. Set to web-inbound's public host to
# have trust-manager sign it and renew it 30 days before expiry; leave unset where the Hub does not
# call back over mutual TLS. Signing uses VAULT_* and needs sign on <mount>/sign/<role>.
HUB_CALLBACK_CERT_COMMON_NAME=
HUB_CALLBACK_CERT_PKI_ROLE=hub-callback-client
HUB_CALLBACK_CERT_CHECK_INTERVAL_SECONDS=86400 # Check for expiry every day, renew 30 days before expiry

REDIS_URL=redis://localhost:7379

DB_WRITE_HOST=localhost
DB_WRITE_PORT=3306
DB_WRITE_USERNAME=central_ledger
DB_WRITE_PASSWORD=password
DB_WRITE_NAME=pivotal
DB_READ_HOST=localhost
DB_READ_PORT=3306
DB_READ_USERNAME=central_ledger
DB_READ_PASSWORD=password
DB_READ_NAME=pivotal

CENTRAL_LEDGER_URL=http://localhost:3001
