WEB_PIVOTAL_PORT=3202

DB_WRITE_HOST=localhost
DB_WRITE_PORT=3306
DB_WRITE_USERNAME=central_ledger
DB_WRITE_PASSWORD=password
DB_WRITE_NAME=pivotal

DB_READ_HOST=localhost
DB_READ_PORT=3306
DB_READ_USERNAME=central_ledger
DB_READ_PASSWORD=password
DB_READ_NAME=pivotal

CENTRAL_LEDGER_URL=http://localhost:3001

# REQUIRED — Redis holding the near-real-time dashboard KPI counters
# (written by app-auditor, read here). Backend refuses to start without it.
REDIS_URL=redis://localhost:6379

# === Pivotal IAM (Phase 1) ===

# REQUIRED — backend refuses to start without these.
PIVOTAL_IAM_JWT_SECRET= --your-jwt-secret-here--
PIVOTAL_IAM_ADMIN_SEED_EMAIL=admin@pivotal.com
PIVOTAL_IAM_ADMIN_SEED_TEMP_PASSWORD=ChangeMe123!

# REQUIRED for the portal at :4173 (vite preview) and :5173 (vite dev) to reach the API at :3202.
PIVOTAL_IAM_CORS_ALLOWED_ORIGINS=http://localhost:4173,http://localhost:5173

# OPTIONAL — defaults shown; uncomment only to override.
# PIVOTAL_IAM_JWT_ISSUER=pivotal
# PIVOTAL_IAM_ACCESS_TOKEN_TTL_SECONDS=900
# PIVOTAL_IAM_REFRESH_TOKEN_TTL_DAYS=14
# PIVOTAL_IAM_BCRYPT_COST_FACTOR=12
# PIVOTAL_IAM_LOGIN_LOCKOUT_THRESHOLD=5
# PIVOTAL_IAM_LOGIN_LOCKOUT_MINUTES=15

# === Audit (Find Transactions) ===

# OPTIONAL — hard cap on rows the query scans/counts/returns. Defaults to 50000.
# Result sets larger than this display as "~50,000+". Values above 50000 are clamped.
AUDIT_MAX_RESULT_ROWS=50000

# === Report Downloads ===

# Keep this disabled in web-pivotal when the dedicated report-worker process is deployed.
REPORT_DOWNLOAD_WORKER_ENABLED=false

# S3 settings are still needed by web-pivotal so authenticated users can download
# report files through the API proxy.
REPORT_S3_ENABLED=true
REPORT_S3_BUCKET=pivotal-reports
REPORT_S3_REGION=us-east-1
REPORT_S3_ACCESS_KEY_ID=minioadmin
REPORT_S3_SECRET_ACCESS_KEY=minioadmin
REPORT_S3_ENDPOINT=http://127.0.0.1:9000
REPORT_S3_FORCE_PATH_STYLE=true
REPORT_S3_PREFIX=reports/
REPORT_S3_PRESIGNED_URL_TTL_SECONDS=900

# ── FSPIOP JWS ───────────────────────────────────────────────────────────────
#
# FSPIOP_USE_JWS is the master switch: outbound signing, and (in web-inbound) the
# inbound guard. When false, nothing below has any effect.
#
# FSPIOP_JWS_VERIFY_MODE is the DEFAULT inbound verification strictness, applied
# only to a source with no row in `participant_key`. A participant's own
# `jws_verify_mode` column always wins -- that override is what lets peers move
# onto signing one at a time instead of by flag day. It is read only by
# web-inbound; no other service verifies FSPIOP signatures.
#
#   off                Signatures ignored entirely.
#   verify-if-present  A present signature must verify; a missing one is accepted
#                      and counted per source. The migration state, and the
#                      rollback. The per-source count of unsigned-but-accepted
#                      requests tells you when `require` is safe for that peer.
#   require            Missing or invalid signature rejected -- 3102 / 3105.
#
# A tri-state rather than a boolean because senders are peer DFSPs and the Hub,
# each enabling signing on its own schedule: `off` leaves a signing peer
# unverified, `require` rejects everyone not yet switched on -- including the Hub,
# which sends its errors unsigned.
#
# Bodyless requests (GET /parties) are accepted unsigned in every mode: a detached
# JWS signs the body, so no implementation signs them.
#
# Outbound signing is per participant (`participant_key.jws_sign_enabled`) and
# needs a key at <VAULT_KV_MOUNT>/<VAULT_JWS_KEY_PATH_PREFIX>/<fspId>.
FSPIOP_USE_JWS=false
FSPIOP_JWS_VERIFY_MODE=off
