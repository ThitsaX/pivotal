# Settings for running the Pivotal services against the shared Mojaloop test-harness MySQL,
# with FSPIOP JWS enabled and keys read from Vault.
#
#   docker compose -p pivotal-stack \
#       -f docker/docker-compose.yml -f docker/docker-compose.shared-db.yml \
#       --env-file docker/jws-loop.env.example --profile vault up -d vault web-inbound
#   python3 scripts/verify-jws-service-loop.py --fsp-id wallet1
#
# MySQL is NOT started here: ml-core-test-harness already provides one holding the `pivotal`
# database. The shared-db overlay drops the dependency and points the services at it.

# FSPIOP JWS on, strictest inbound, keys from Vault.
FSPIOP_USE_JWS=true
FSPIOP_JWS_VERIFY_MODE=off
KEY_PROVIDER=vault-kv
VAULT_ADDRESS=http://vault:8200

# Development only. Outside Kubernetes there is no ServiceAccount token to exchange.
VAULT_AUTH_METHOD=token
VAULT_TOKEN=root-dev
VAULT_DEV_ROOT_TOKEN=root-dev
VAULT_SEED_TENANTS=wallet1,wallet2

# The Mojaloop test harness owns 3306, 3000, 3001, 3002 and 4001-4002.
MYSQL_HOST_PORT=3307
NATS_HOST_PORT=4222
REDIS_HOST_PORT=6380
VAULT_HOST_PORT=8210
WEB_OUTBOUND_HOST_PORT=3200
WEB_INBOUND_HOST_PORT=3201
WEB_PIVOTAL_HOST_PORT=3203
